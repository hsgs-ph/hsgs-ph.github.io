---
import YouTube from '../../components/YouTube.astro';
import { prototypeVideo } from '../../data/siteMedia';
import Page from '../../layouts/Page.astro';
---

<Page title="Hệ thống" eyebrow="04 / NGUYÊN MẪU VÀ KIẾN TRÚC">
  <div class="content-grid system-overview-grid">
    <article>
      <h2>Một chu trình đo hoàn chỉnh</h2>
      <p>Hệ thống điều khiển bơm, van, cảm biến pH và bộ ghi dữ liệu theo thứ tự có thể truy vết.</p>
      <div class="system-flow">
        <span>Rửa</span><b>→</b><span>Đo pH</span><b>→</b><span>Ghi dữ liệu</span><b>→</b><span>Bảo quản</span>
      </div>
    </article>
    <aside class="notice system-notice">
      <center><h3>VIDEO MỘT CHU TRÌNH HOÀN CHỈNH</h3></center>
      <div class="system-image-frame">
        {prototypeVideo.youtubeUrl ? (
          <YouTube id={prototypeVideo.youtubeUrl} title={prototypeVideo.title} caption={prototypeVideo.caption} />
        ) : (
          <div class="video-placeholder" role="img" aria-label="Vị trí video một chu trình hoàn chỉnh">
            <span aria-hidden="true">▶</span>
            <small>Chưa có video YouTube</small>
          </div>
        )}
      </div>
    </aside>
  </div>
</Page>
