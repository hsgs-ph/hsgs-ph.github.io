---
import { getCollection, render } from 'astro:content';
import Figure from '../../components/Figure.astro';
import ReadingLayout from '../../components/ReadingLayout.astro';
import YouTube from '../../components/YouTube.astro';
import { isMainJournal } from '../../data/mainJournals';
import Page from '../../layouts/Page.astro';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const entries = (await getCollection('journal'))
  .filter((entry) => isMainJournal(entry.id))
  .sort((a, b) => a.data.researchDate.valueOf() - b.data.researchDate.valueOf());
const index = entries.findIndex((entry) => entry.id === post.id);
const previous = index >= 0 ? entries[index - 1] : undefined;
const next = index >= 0 ? entries[index + 1] : undefined;
const experiments = await getCollection('experiments');
const related = experiments.filter((experiment) => post.data.experimentIds.includes(experiment.data.id));
const videos = [
  ...post.data.youtubeVideos,
  ...post.data.youtubeIds.map((id) => ({ id, title: `Video nghiên cứu — ${post.data.title}` })),
];
const githubBase = import.meta.env.PUBLIC_GITHUB_REPO_URL || 'https://github.com/hsgs-ph/hsgs-ph.github.io';
const directoryItems = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  href: `${import.meta.env.BASE_URL}journal/${entry.id}/`,
  meta: entry.data.researchDate.toLocaleDateString('vi-VN'),
  draft: entry.data.draft,
}));
---

<Page title={post.data.title} eyebrow={`${post.data.researchDate.toLocaleDateString('vi-VN')} / NHẬT KÝ`}>
  <ReadingLayout
    headings={headings}
    directoryItems={directoryItems}
    currentId={post.id}
    directoryTitle="Toàn bộ nhật ký"
  >
    <p class="summary">{post.data.summary}</p>
    <div class="entry-meta">
      <time datetime={post.data.researchDate.toISOString()}>{post.data.researchDate.toLocaleDateString('vi-VN')}</time>
      <span class:list={['status-chip', post.data.draft ? 'draft' : 'published']}>
        {post.data.draft ? 'Chưa công bố' : 'Đã công bố'}
      </span>
      <span>{post.data.status}</span>
      <span>· {post.data.authors.join(', ')}</span>
    </div>
    <div class="article-links">
      {related.map((experiment) => (
        <a href={`${import.meta.env.BASE_URL}experiments/${experiment.data.id}/`}>
          Thí nghiệm {experiment.data.id}: {experiment.data.title} →
        </a>
      ))}
      {post.data.systemVersion && <a href={`${import.meta.env.BASE_URL}system/`}>Phiên bản {post.data.systemVersion} →</a>}
      {githubBase && <a href={`${githubBase}/commits/main/src/content/journal/${post.id}.md`}>Xem lịch sử tệp trên GitHub ↗</a>}
    </div>
    <div class="prose"><Content /></div>
    {post.data.images.length > 0 && (
      <div class="media-grid">{post.data.images.map((image) => <Figure {...image} />)}</div>
    )}
    {videos.length > 0 && (
      <div class="media-grid">{videos.map((video) => <YouTube {...video} />)}</div>
    )}
    <nav class="prev-next" aria-label="Bài nhật ký liền kề">
      {previous ? <a href={`${import.meta.env.BASE_URL}journal/${previous.id}/`}>← {previous.data.title}</a> : <span />}
      {next ? <a href={`${import.meta.env.BASE_URL}journal/${next.id}/`}>{next.data.title} →</a> : <span />}
    </nav>
  </ReadingLayout>
</Page>
