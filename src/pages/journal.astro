---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import { isMainJournal } from '../data/mainJournals';

const entries = (await getCollection('journal'))
  .filter((entry) => isMainJournal(entry.id))
  .sort((a, b) => b.data.researchDate.valueOf() - a.data.researchDate.valueOf());
---

<Page title="Nhật ký nghiên cứu" eyebrow="02 / DÒNG THỜI GIAN">
  <p class="page-intro">Toàn bộ nhật ký được trình bày dưới dạng tóm tắt. Những bài chưa công bố vẫn giữ nguyên trạng thái và được đánh dấu rõ ràng.</p>
  <form class="filters">
    <input aria-label="Tìm kiếm" placeholder="Tìm trong nhật ký..." />
    <select aria-label="Loại hoạt động">
      <option value="">Tất cả hoạt động</option>
      <option value="tai-lieu">Tài liệu</option>
      <option value="co-khi">Cơ khí</option>
      <option value="dien-tu">Điện tử</option>
      <option value="lap-trinh">Lập trình</option>
      <option value="che-tao">Chế tạo</option>
      <option value="hieu-chuan">Hiệu chuẩn</option>
      <option value="thi-nghiem">Thí nghiệm</option>
      <option value="phan-tich">Phân tích</option>
      <option value="sua-loi">Sửa lỗi</option>
      <option value="bao-cao">Báo cáo</option>
    </select>
    <select aria-label="Trạng thái">
      <option value="">Mọi trạng thái</option>
      <option value="planned">Dự kiến</option>
      <option value="completed">Hoàn thành</option>
      <option value="in-progress">Đang thực hiện</option>
      <option value="issue">Phát sinh vấn đề</option>
    </select>
    <select aria-label="Trạng thái công bố">
      <option value="">Tất cả bài</option>
      <option value="published">Đã công bố</option>
      <option value="draft">Chưa công bố</option>
    </select>
    <button class="button secondary" id="clear" type="button">Xóa bộ lọc</button>
  </form>
  <p id="count" aria-live="polite">{entries.length} bài nhật ký</p>
  <div class="entry-list journal-summary-list">
    {entries.map((entry) => (
      <article
        class="entry"
        data-type={entry.data.activityTypes.join(',')}
        data-status={entry.data.status}
        data-publication={entry.data.draft ? 'draft' : 'published'}
      >
        <div class="entry-meta">
          <time datetime={entry.data.researchDate.toISOString()}>{entry.data.researchDate.toLocaleDateString('vi-VN')}</time>
          <span class:list={['status-chip', entry.data.draft ? 'draft' : 'published']}>
            {entry.data.draft ? 'Chưa công bố' : 'Đã công bố'}
          </span>
          <span>{entry.data.activityTypes.join(' · ')}</span>
        </div>
        <h2>{entry.data.title}</h2>
        <p>{entry.data.summary}</p>
        <a href={`${import.meta.env.BASE_URL}journal/${entry.id}/`}>Mở toàn bài →</a>
      </article>
    ))}
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>('.filters');
    const cards = [...document.querySelectorAll<HTMLElement>('.entry-list .entry')];
    const count = document.querySelector<HTMLParagraphElement>('#count');

    function filterEntries() {
      if (!form || !count) return;
      const input = form.querySelector<HTMLInputElement>('input')?.value.toLocaleLowerCase('vi') ?? '';
      const selects = form.querySelectorAll<HTMLSelectElement>('select');
      const type = selects[0]?.value ?? '';
      const status = selects[1]?.value ?? '';
      const publication = selects[2]?.value ?? '';
      let visible = 0;

      for (const card of cards) {
        const activityTypes = card.dataset.type?.split(',') ?? [];
        const show = (card.textContent?.toLocaleLowerCase('vi').includes(input) ?? false)
          && (!type || activityTypes.includes(type))
          && (!status || card.dataset.status === status)
          && (!publication || card.dataset.publication === publication);
        card.hidden = !show;
        if (show) visible += 1;
      }
      count.textContent = `${visible} bài nhật ký`;
    }

    form?.addEventListener('input', filterEntries);
    document.querySelector('#clear')?.addEventListener('click', () => {
      form?.reset();
      filterEntries();
    });
  </script>
</Page>
