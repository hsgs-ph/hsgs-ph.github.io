---
import Page from '../layouts/Page.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort((a, b) => b.data.researchDate.valueOf() - a.data.researchDate.valueOf());
---
<Page title="Nhật ký nghiên cứu" eyebrow="02 / DÒNG THỜI GIAN"><form class="filters"><input aria-label="Tìm kiếm" placeholder="Tìm trong nhật ký..." /><select aria-label="Loại hoạt động"><option value="">Tất cả hoạt động</option><option value="co-khi">Cơ khí</option><option value="thi-nghiem">Thí nghiệm</option><option value="hieu-chuan">Hiệu chuẩn</option></select><select aria-label="Trạng thái"><option value="">Mọi trạng thái</option><option value="completed">Hoàn thành</option><option value="in-progress">Đang thực hiện</option><option value="issue">Phát sinh vấn đề</option></select><button class="button secondary" id="clear" type="button">Xóa bộ lọc</button></form><p id="count">{entries.length} bài nhật ký</p><div class="entry-list">{entries.map((entry)=><article class="entry" data-type={entry.data.activityTypes[0]} data-status={entry.data.status}><div class="entry-meta"><time>{entry.data.researchDate.toLocaleDateString('vi-VN')}</time><span class="dot"></span><span>{entry.data.activityTypes.join(', ')}</span></div><h2>{entry.data.title}</h2><p>{entry.data.summary}</p><a href={`${import.meta.env.BASE_URL}journal/${entry.id}/`}>Mở bài viết ↗</a></article>)}</div><script>const form=document.querySelector('.filters') as HTMLFormElement;const cards=[...document.querySelectorAll('.entry-list .entry')] as HTMLElement[];const count=document.querySelector('#count') as HTMLParagraphElement;function filter(){const input=(form.querySelector('input') as HTMLInputElement).value.toLowerCase();const selects=form.querySelectorAll('select');const type=(selects[0] as HTMLSelectElement).value;const status=(selects[1] as HTMLSelectElement).value;let n=0;cards.forEach(card=>{const show=card.textContent?.toLowerCase().includes(input)&&(!type||card.dataset.type===type)&&(!status||card.dataset.status===status);card.hidden=!show;if(show)n++});count.textContent=`${n} bài nhật ký`}form.addEventListener('input',filter);document.querySelector('#clear')?.addEventListener('click',()=>{form.reset();filter()});</script></Page>