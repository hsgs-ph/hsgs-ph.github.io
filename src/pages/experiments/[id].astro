---
import { getCollection, render } from 'astro:content';
import Figure from '../../components/Figure.astro';
import ReadingLayout from '../../components/ReadingLayout.astro';
import Page from '../../layouts/Page.astro';

export async function getStaticPaths() {
  const experiments = await getCollection('experiments');
  return experiments.map((experiment) => ({
    params: { id: experiment.data.id },
    props: { experiment },
  }));
}

const { experiment } = Astro.props;
const { Content, headings } = await render(experiment);
const experiments = (await getCollection('experiments')).sort((a, b) => a.data.order - b.data.order);
const related = (await getCollection('journal', ({ data }) => data.experimentIds.includes(experiment.data.id)))
  .sort((a, b) => b.data.researchDate.valueOf() - a.data.researchDate.valueOf());
const directoryItems = experiments.map((item) => ({
  id: item.data.id,
  title: item.data.title,
  href: `${import.meta.env.BASE_URL}experiments/${item.data.id}/`,
  meta: item.data.id,
}));
---

<Page title={`${experiment.data.id} · ${experiment.data.title}`} eyebrow={`${experiment.data.id} / THÍ NGHIỆM`}>
  <ReadingLayout
    headings={headings}
    directoryItems={directoryItems}
    currentId={experiment.data.id}
    directoryTitle="Toàn bộ thí nghiệm"
  >
    <div class="entry-meta">
      <span class="dot orange"></span>
      <span>{experiment.data.status}</span>
      <span>· Bắt đầu {experiment.data.startDate.toLocaleDateString('vi-VN')}</span>
      <span>· {experiment.data.dataStatus}</span>
    </div>
    <p class="summary">{experiment.data.summary}</p>
    <div class="data-grid">
      <div><b>Biến độc lập</b><span>{experiment.data.independentVariables.join(', ') || 'Chưa có dữ liệu'}</span></div>
      <div><b>Biến phụ thuộc</b><span>{experiment.data.dependentVariables.join(', ') || 'Chưa có dữ liệu'}</span></div>
      <div><b>Biến kiểm soát</b><span>{experiment.data.controlVariables.join(', ') || 'Chưa có dữ liệu'}</span></div>
    </div>
    <div class="prose"><Content /></div>
    {experiment.data.images.length > 0 && (
      <section class="experiment-evidence">
        <h2>Kết quả và minh chứng</h2>
        <div class="media-grid">
          {experiment.data.images.map((image) => <Figure {...image} />)}
        </div>
      </section>
    )}
    <h2>Nhật ký liên quan</h2>
    {related.length ? (
      <div class="entry-list">
        {related.map((entry) => (
          <article class="entry">
            <div class="entry-meta">
              <time datetime={entry.data.researchDate.toISOString()}>{entry.data.researchDate.toLocaleDateString('vi-VN')}</time>
              <span class:list={['status-chip', entry.data.draft ? 'draft' : 'published']}>
                {entry.data.draft ? 'Chưa công bố' : 'Đã công bố'}
              </span>
            </div>
            <h3>{entry.data.title}</h3>
            <a href={`${import.meta.env.BASE_URL}journal/${entry.id}/`}>Đọc nhật ký →</a>
          </article>
        ))}
      </div>
    ) : (
      <div class="notice">Chưa có bài nhật ký liên quan.</div>
    )}
  </ReadingLayout>
</Page>
