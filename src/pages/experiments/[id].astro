---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
export async function getStaticPaths() { const experiments = await getCollection('experiments'); return experiments.map((experiment) => ({ params: { id: experiment.data.id }, props: { experiment } })); }
const { experiment } = Astro.props; const { Content } = await render(experiment); const journal = await getCollection('journal'); const related = journal.filter((entry) => entry.data.experimentIds.includes(experiment.data.id));
---
<Page title={`${experiment.data.id} · ${experiment.data.title}`} eyebrow={`${experiment.data.id} / THÍ NGHIỆM`}><article class="article"><div class="entry-meta"><span class="dot orange"></span><span>{experiment.data.status}</span><span>· Bắt đầu {experiment.data.startDate.toLocaleDateString('vi-VN')}</span></div><p class="summary">{experiment.data.summary}</p><div class="data-grid"><div><b>Biến độc lập</b><span>{experiment.data.independentVariables.join(', ') || 'Chưa có dữ liệu'}</span></div><div><b>Biến phụ thuộc</b><span>{experiment.data.dependentVariables.join(', ') || 'Chưa có dữ liệu'}</span></div><div><b>Biến kiểm soát</b><span>{experiment.data.controlVariables.join(', ') || 'Chưa có dữ liệu'}</span></div></div><div class="prose"><Content /></div><h2>Nhật ký liên quan</h2>{related.length ? <div class="entry-list">{related.map((entry) => <article class="entry"><div class="entry-meta"><time>{entry.data.researchDate.toLocaleDateString('vi-VN')}</time></div><h3>{entry.data.title}</h3><a href={`${import.meta.env.BASE_URL}journal/${entry.id}/`}>Đọc nhật ký →</a></article>)}</div> : <div class="notice">Chưa có bài nhật ký liên quan.</div>}</article></Page>
