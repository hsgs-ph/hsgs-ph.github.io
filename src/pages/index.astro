---
import '../styles/global.css';
import '../styles/fonts.css';
import { getCollection } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { isMainJournal } from '../data/mainJournals';
import { homePrototypeImage } from '../data/siteMedia';

const publicEntries = (await getCollection('journal', ({ data }) => !data.draft))
  .filter((entry) => isMainJournal(entry.id))
  .sort((a, b) => b.data.researchDate.valueOf() - a.data.researchDate.valueOf());
const entries = publicEntries.slice(0, 3);
const experiments = await getCollection('experiments');
const base = import.meta.env.BASE_URL;
const basePrefix = base === '/' ? '' : base.replace(/\/$/, '');
const path = (href: string) => `${basePrefix}/${href.replace(/^\//, '')}`;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={Astro.url} />
    <meta name="description" content="Nhật ký nghiên cứu hệ thống tự động đo pH." />
    <meta name="theme-color" content="#083b52" />
    <title>Nhật ký nghiên cứu | Hệ thống đo pH</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <p class="eyebrow">Hồ sơ nghiên cứu · 2026</p>
          <h1>Hệ thống tự động đo pH định kỳ <em>trong môi trường nước</em></h1>
          <p class="lede">Một nhật ký mở ghi lại quá trình thiết kế, thử nghiệm và hoàn thiện cơ chế bảo quản điện cực, cùng những bằng chứng có thể đối chiếu.</p>
          <div class="actions">
            <a class="button primary" href={path('/journal/')}>Xem nhật ký nghiên cứu <span>↗</span></a>
            <a class="button secondary" href={path('/results/')}>Xem kết quả thí nghiệm</a>
          </div>
        </div>
        <figure class="hero-figure prototype-showcase">
          <div class="prototype-frame">
            {homePrototypeImage.src ? (
              <img src={homePrototypeImage.src} alt={homePrototypeImage.alt} />
            ) : (
              <div class="prototype-image-placeholder" role="img" aria-label="Vị trí ảnh mô hình nguyên mẫu">
                <span aria-hidden="true">＋</span>
                <strong>Ảnh mô hình nguyên mẫu</strong>
                <small>Thêm ảnh thật sau khi đã tối ưu cho website</small>
              </div>
            )}
          </div>
          <figcaption><span>Mô hình nguyên mẫu</span><small>Hệ thống tự động đo pH định kỳ</small></figcaption>
        </figure>
      </section>

      <section class="stats shell" aria-label="Tóm tắt dự án">
        <div><b>08.2026</b><span>Ngày bắt đầu</span></div>
        <div><b>{new Set(publicEntries.map((entry) => entry.data.researchDate.toISOString().slice(0, 10))).size}</b><span>Ngày có nhật ký</span></div>
        <div><b>{publicEntries.length}</b><span>Bài nhật ký</span></div>
        <div><b>{experiments.length.toString().padStart(2, '0')}</b><span>Thí nghiệm</span></div>
        <div><b>v0.2</b><span>Phiên bản mới nhất</span></div>
      </section>

      <section class="progress-band">
        <div class="shell">
          <div class="section-heading">
            <div><p class="eyebrow">Tiến độ dự án</p><h2>Từ câu hỏi đến nguyên mẫu</h2></div>
            <a href={path('/about/')}>Xem toàn bộ phương pháp →</a>
          </div>
          <div class="progress-grid">
            {['Xác định vấn đề', 'Thiết kế nguyên mẫu', 'Hiệu chuẩn cảm biến', 'Kiểm chứng bơm và buồng đo', 'Thử nghiệm dài hạn', 'Hoàn thiện sản phẩm'].map((item, index) => (
              <div class={`progress-item ${index < 2 ? 'done' : index === 2 ? 'active' : ''}`}>
                <span class="progress-number">0{index + 1}</span>
                <div>
                  <strong>{item}</strong>
                  <small>{index < 2 ? 'Đã hoàn thành' : index === 2 ? 'Đang thực hiện' : 'Chưa thực hiện'}</small>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="journal-preview shell">
        <div class="section-heading">
          <div><p class="eyebrow">Nhật ký mới nhất</p><h2>Những bước tiến gần đây</h2></div>
          <a href={path('/journal/')}>Tất cả bài viết →</a>
        </div>
        <div class="entry-grid">
          {entries.map((entry) => (
            <article class="entry">
              <div class="entry-meta">
                <time datetime={entry.data.researchDate.toISOString()}>{entry.data.researchDate.toLocaleDateString('vi-VN')}</time>
                <span class="dot"></span>
                <span>{entry.data.activityTypes.join(', ')}</span>
              </div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary}</p>
              <a href={path(`/journal/${entry.id}/`)}>Đọc bài viết <span>↗</span></a>
            </article>
          ))}
        </div>
      </section>
    </main>
    <SiteFooter updatedText="Cập nhật lần cuối: 28.08.2026" />
  </body>
</html>
