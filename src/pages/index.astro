---
import '../styles/global.css';
import '../styles/fonts.css';
import { getCollection } from 'astro:content';
const nav = [['Trang chủ', '/'], ['Giới thiệu', '/about/'], ['Nhật ký', '/journal/'], ['Thí nghiệm', '/experiments/'], ['Hệ thống', '/system/'], ['Kết quả', '/results/']];
const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort((a, b) => b.data.researchDate.valueOf() - a.data.researchDate.valueOf()).slice(0, 3);
const experiments = await getCollection('experiments');
const path = (href: string) => `${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '')}/${href.replace(/^\//, '')}`;
---
<html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><link rel="canonical" href={Astro.url} /><meta name="description" content="Nhật ký nghiên cứu hệ thống tự động đo pH." /><title>Nhật ký nghiên cứu | Hệ thống đo pH</title></head><body>
<header class="site-header"><div class="shell nav-wrap"><a class="brand" href={import.meta.env.BASE_URL}><span class="brand-mark">pH</span><span>Nhật ký<br /><strong>nghiên cứu</strong></span></a><nav aria-label="Điều hướng chính">{nav.map(([label, href]) => <a href={path(href)}>{label}</a>)}</nav><button class="menu" aria-label="Mở menu">☰</button></div></header>
<main><section class="hero shell"><div class="hero-copy"><p class="eyebrow">HỒ SƠ NGHIÊN CỨU · 2026</p><h1>Hệ thống tự động đo pH định kỳ <em>trong môi trường nước</em></h1><p class="lede">Một nhật ký mở ghi lại quá trình thiết kế, thử nghiệm và hoàn thiện cơ chế bảo quản điện cực, cùng những bằng chứng có thể đối chiếu.</p><div class="actions"><a class="button primary" href={path('/journal/')}>Xem nhật ký nghiên cứu <span>↗</span></a><a class="button secondary" href={path('/results/')}>Xem kết quả thí nghiệm</a></div></div><div class="hero-figure"><div class="diagram"><div class="diagram-label">MÔ HÌNH NGUYÊN MẪU</div><div class="tank"><i></i><i></i><i></i><span>pH</span></div><div class="tube"></div><div class="sensor"></div><small>BUỒNG ĐO<br />BẢO QUẢN ĐIỆN CỰC</small></div></div></section>
<section class="stats shell"><div><b>08.2026</b><span>Ngày bắt đầu</span></div><div><b>{new Set(entries.map((entry) => entry.data.researchDate.toISOString().slice(0, 10))).size}</b><span>Ngày có nhật ký</span></div><div><b>{entries.length}</b><span>Bài nhật ký</span></div><div><b>{experiments.length.toString().padStart(2, '0')}</b><span>Thí nghiệm</span></div><div><b>v0.2</b><span>Phiên bản mới nhất</span></div></section>
<section class="progress-band"><div class="shell"><div class="section-heading"><div><p class="eyebrow">TIẾN ĐỘ DỰ ÁN</p><h2>Từ câu hỏi đến nguyên mẫu</h2></div><a href={path('/about/')}>Xem toàn bộ phương pháp →</a></div><div class="progress-grid">{['Xác định vấn đề', 'Thiết kế nguyên mẫu', 'Hiệu chuẩn cảm biến', 'Kiểm chứng bơm và buồng đo', 'Thử nghiệm dài hạn', 'Hoàn thiện sản phẩm'].map((item, index) => <div class={`progress-item ${index < 2 ? 'done' : index === 2 ? 'active' : ''}`}><span class="progress-number">0{index + 1}</span><div><strong>{item}</strong><small>{index < 2 ? 'Đã hoàn thành' : index === 2 ? 'Đang thực hiện' : 'Chưa thực hiện'}</small></div></div>)}</div></div></section>
<section class="journal-preview shell"><div class="section-heading"><div><p class="eyebrow">NHẬT KÝ MỚI NHẤT</p><h2>Những bước tiến gần đây</h2></div><a href={path('/journal/')}>Tất cả bài viết →</a></div><div class="entry-grid">{entries.map((entry) => <article class="entry"><div class="entry-meta"><time>{entry.data.researchDate.toLocaleDateString('vi-VN')}</time><span class="dot"></span><span>{entry.data.activityTypes.join(', ')}</span></div><h3>{entry.data.title}</h3><p>{entry.data.summary}</p><a href={path(`/journal/${entry.id}/`)}>Đọc bài viết <span>↗</span></a></article>)}</div></section></main>
<footer><div class="shell footer-grid"><div><a class="brand" href={import.meta.env.BASE_URL}><span class="brand-mark">pH</span><span>Nhật ký<br /><strong>nghiên cứu</strong></span></a><p>Minh chứng cho một quá trình nghiên cứu trung thực, có thể kiểm chứng.</p></div><div><b>Tài nguyên</b><a href={path('/about/')}>Giới thiệu đề tài</a><a href={path('/experiments/')}>Danh sách thí nghiệm</a><a href="https://github.com/hsgs-ph/hsgs-ph.github.io">Repository GitHub ↗</a></div><div><b>Thông tin</b><span>Cập nhật lần cuối: 28.08.2026</span><span>Dữ liệu minh họa · cần thay thế</span></div></div></footer></body></html>
